# Prebuilt-jar image. The fat jar is built on the HOST with `mvn -o package`
# because this network's TLS interception blocks the in-container Maven build
# from reaching Maven Central. We just copy the jar into a JRE runtime.
FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
COPY target/*.jar app.jar
ENTRYPOINT ["java", "-jar", "app.jar"]
