# Real fixtures ingestion (football-data.org).
# 1) Get a FREE key: https://www.football-data.org/client/register
# 2) Copy this file to ".env" (same folder as docker-compose.full.yml) and paste your key
# 3) Restart the service:
#    docker compose -f docker-compose.full.yml -f docker-compose.local.yml up -d training-match-service
FOOTBALL_DATA_API_KEY=
# Optional tuning:
FOOTBALL_WINDOW_DAYS=60          # how far ahead to ingest
FOOTBALL_SYNC_INTERVAL_MS=1800000  # auto-sync every 30 min
