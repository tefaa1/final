    java/.style={draw, rounded corners=2pt, fill=barcaBlue!15,
                 minimum width=2.6cm, minimum height=0.7cm, align=center},
    py/.style={draw, rounded corners=2pt, fill=barcaRed!10,
               minimum width=2.6cm, minimum height=0.7cm, align=center},
    infra/.style={draw, rounded corners=2pt, fill=gray!18,
                  minimum width=2.6cm, minimum height=0.7cm, align=center},
    net/.style={draw, dashed, rounded corners=8pt, inner sep=14pt},
    host/.style={draw, rounded corners=10pt, inner sep=22pt, dashed,
                 line width=0.6pt}
]
