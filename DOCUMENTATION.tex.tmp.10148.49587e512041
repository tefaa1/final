% ─── System Models / Database Design ────────────────────────────────
\section{Database Design}
\label{sec:db}

\subsection{Polyglot persistence strategy}
The data layer follows the \emph{database-per-service} pattern. Each Java
microservice owns one PostgreSQL database; cross-service references use
opaque identifiers (Keycloak UUIDs for users, foreign-key IDs for entities)
rather than direct database joins. This isolates each service's schema
evolution.

\begin{longtable}{p{0.32\textwidth} p{0.62\textwidth}}
\toprule
\textbf{Database} & \textbf{Primary tables} \\
\midrule
\texttt{mscms\_user} &
  \texttt{user\_profile}, \texttt{player\_profile},
  \texttt{head\_coach\_profile}, \texttt{doctor\_profile},
  \texttt{physiotherapist\_profile}, \texttt{fitness\_coach\_profile},
  \texttt{team\_manager\_profile}, \texttt{sport\_manager\_profile},
  \texttt{scout\_profile}, \texttt{sponsor\_profile}, \texttt{fan\_profile},
  \texttt{national\_team\_profile} \\

\texttt{mscms\_player} &
  \texttt{sports}, \texttt{teams}, \texttt{rosters}, \texttt{player\_contracts},
  \texttt{outer\_teams}, \texttt{outer\_players},
  \texttt{player\_transfer\_incoming}, \texttt{player\_transfer\_outgoing},
  \texttt{player\_call\_up\_requests} \\

\texttt{mscms\_training} &
  \texttt{training\_sessions}, \texttt{training\_plans},
  \texttt{training\_drills}, \texttt{training\_attendance},
  \texttt{player\_training\_assessments}, \texttt{matches},
  \texttt{match\_formations}, \texttt{match\_lineups},
  \texttt{match\_events}, \texttt{match\_performance\_reviews},
  \texttt{player\_match\_statistics} \\

\texttt{mscms\_medical} &
  \texttt{injuries}, \texttt{diagnoses}, \texttt{treatments},
  \texttt{rehabilitations}, \texttt{recovery\_programs},
  \texttt{fitness\_tests}, \texttt{training\_loads} \\

\texttt{mscms\_notification} &
  \texttt{notifications}, \texttt{alerts}, \texttt{messages} \\

\texttt{mscms\_reports} &
  \texttt{match\_analysis}, \texttt{player\_analytics},
  \texttt{team\_analytics}, \texttt{training\_analytics},
  \texttt{scout\_reports}, \texttt{sponsor\_contract\_offers} \\
\bottomrule
\end{longtable}

\subsection{Cross-service identifiers}
Three classes of identifier are shared across databases:
\begin{itemize}[leftmargin=*]
  \item \textbf{Keycloak UUID} (\texttt{keycloakId}) --- the canonical
        identity for a person. Every service stores this string instead of
        a numeric FK to \texttt{mscms\_user}.
  \item \textbf{Numeric domain IDs} --- e.g.\ \texttt{teamId},
        \texttt{playerId}, \texttt{matchId}, \texttt{sportId}. These are
        the JPA auto-generated primary keys of \texttt{mscms\_player} and
        \texttt{mscms\_training}. The seeders preserve a deterministic
        insert order so that \texttt{teamId = 1} always means
        \emph{FC Barcelona} across every service.
  \item \textbf{Realm role names} --- string identifiers (e.g.
        \texttt{ADMIN}, \texttt{HEAD\_COACH}) embedded in the JWT.
\end{itemize}

\subsection{Entity-relationship snapshot}
Figure~\ref{fig:er} sketches the principal relationships among the
business entities (see the dedicated \texttt{ER\_DIAGRAM.md} file for the
full diagram in Mermaid form).

\begin{figure}[ht]
\centering
