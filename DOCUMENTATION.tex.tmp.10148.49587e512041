    every node/.style={font=\footnotesize\sffamily},
    table/.style={draw, rounded corners=2pt, minimum width=2.4cm,
                  minimum height=0.7cm, fill=barcaBlue!10},
    rel/.style={-{Latex[length=1.5mm]}, gray},
    node distance=0.6cm and 1.4cm
]
\node[table] (sport) {Sport};
\node[table, right=of sport] (team) {Team};
\node[table, right=of team] (roster) {Roster};
\node[table, below=of team] (contract) {Contract};
\node[table, below=of roster] (player) {Player (Keycloak)};
\node[table, right=of player] (outer) {OuterPlayer};
\node[table, below=of player] (match) {Match};
\node[table, below=of contract] (injury) {Injury};
\node[table, below=of match] (analytics) {PlayerAnalytics};

\draw[rel] (sport) -- (team);
\draw[rel] (team) -- (roster);
\draw[rel] (player) -- (roster);
\draw[rel] (player) -- (contract);
\draw[rel] (team) -- (match);
\draw[rel] (outer) -- (match);
\draw[rel] (player) -- (injury);
