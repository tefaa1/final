% =====================================================================
\chapter{System Models}
\label{ch:system-models}

This chapter groups the four design views of MSCMS:
\emph{architecture}, \emph{microservices decomposition},
\emph{database design}, \emph{authentication flow},
\emph{deployment topology} and the \emph{use case diagram}. Each is
expressed as a TikZ figure plus a short explanation. Per-operation
sequence diagrams have their own chapter (Chapter~\ref{ch:sequence}).

\section{System Architecture}
\label{sec:arch}

\subsection{Overview}
MSCMS follows the classic \emph{API Gateway $+$ Service Discovery $+$
Centralised Configuration} pattern recommended by Spring Cloud
documentation. Figure~\ref{fig:high-level} shows the high-level view: every
external request enters through the Gateway, which delegates to the right
internal microservice after JWT validation. Each microservice owns its own
PostgreSQL database, and cross-service communication is either synchronous
(internal REST through the gateway) or asynchronous (Kafka events).

% ── High-level architecture diagram (TikZ) ──────────────────────────
\begin{figure}[ht]
\centering
\begin{tikzpicture}[
    node distance=1.1cm and 1.3cm,
    box/.style={draw, rounded corners=3pt, minimum width=2.6cm,
                minimum height=0.9cm, font=\small\sffamily, fill=barcaBlue!10},
    infra/.style={box, fill=gray!12},
    ml/.style={box, fill=barcaRed!10},
    arr/.style={-{Latex[length=2mm]}, thick, gray}
]
\node[box] (web) {Next.js Front-end};
\node[box, below=of web] (gw) {API Gateway};

\node[box, below left=of gw, xshift=-2.6cm] (user) {user-mgmt};
\node[box, right=of user] (player) {player-mgmt};
\node[box, right=of player] (training) {training-match};
\node[box, below=of user] (medical) {medical-fitness};
\node[box, right=of medical] (notif) {notification};
\node[box, right=of notif] (reports) {reports-analytics};

\node[infra, below=2.0cm of gw] (eureka) {Eureka + Config};
\node[ml, right=of training, xshift=0.4cm] (ml1) {ML: Match};
\node[ml, below=of ml1] (ml2) {ML: Player};

\node[infra, below=of medical, xshift=2.6cm, yshift=-0.6cm] (pg) {PostgreSQL ($\times$6 DBs)};
\node[infra, right=of pg] (kc) {Keycloak};
\node[infra, right=of kc] (kafka) {Kafka + Redis};

\draw[arr] (web) -- (gw);
\draw[arr] (gw) -- (user); \draw[arr] (gw) -- (player);
\draw[arr] (gw) -- (training);
\draw[arr] (gw) -- (medical); \draw[arr] (gw) -- (notif);
\draw[arr] (gw) -- (reports);
\draw[arr] (gw) -- (ml1.west); \draw[arr] (gw) -- (ml2.west);
\draw[arr, dashed] (user) -- (eureka); \draw[arr, dashed] (player) -- (eureka);
\draw[arr, dashed] (training) -- (eureka); \draw[arr, dashed] (medical) -- (eureka);
\draw[arr, dashed] (notif) -- (eureka); \draw[arr, dashed] (reports) -- (eureka);
\draw[arr] (user) -- (pg.north); \draw[arr] (player) -- (pg.north);
\draw[arr] (training) -- (pg.north); \draw[arr] (medical) -- (pg.north);
\draw[arr] (reports) -- (pg.north);
